# Copy to .env, enter real SMTP credentials locally, and export before starting Python.
# server.py reads environment variables; it does not automatically load this file.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=rehab@example.com
SMTP_USER=rehab@example.com
SMTP_PASSWORD=replace-with-mail-authorization-code
# SMTP_SECURITY=ssl normally uses port 465. Both modes require certificate validation.
# REHAB_DB=/absolute/persistent/path/rehab.sqlite3
